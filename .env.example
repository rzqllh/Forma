# Cloudflare Worker Server-to-Server Secret (X-App-Secret / Authorization Bearer)
APP_SHARED_SECRET=development-shared-secret-change-in-prod

# Cloudflare Access Configuration (Edge Identity Protection)
CF_ACCESS_TEAM_DOMAIN=forma-team
CF_ACCESS_POLICY_AUD=your-cloudflare-access-audience-tag

# Additional Allowed Origins for CORS (Comma-separated)
ALLOWED_ORIGINS=https://forma-app.pages.dev,https://preview.forma-app.pages.dev

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=mawmaw-interior
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=mawmaw-interior
CLOUDINARY_API_KEY=your-api-key-here
CLOUDINARY_API_SECRET=your-api-secret-here

# API Base URL for Client (Cloudflare Worker default port is 8787 in local dev)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787
