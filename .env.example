# Cloudflare Worker Shared Secret Header Gate (X-App-Secret)
APP_SHARED_SECRET=development-shared-secret-change-in-prod
NEXT_PUBLIC_APP_SHARED_SECRET=development-shared-secret-change-in-prod

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=mawmaw-interior
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=mawmaw-interior
CLOUDINARY_API_KEY=your-api-key-here
CLOUDINARY_API_SECRET=your-api-secret-here

# API Base URL for Client (Cloudflare Worker default port is 8787)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787
